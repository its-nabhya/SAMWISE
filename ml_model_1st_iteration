"""
===============================================================
Early Fall Prediction Network

Author : Maulik Parasramka

Architecture

Input (100x12)

↓

Input BatchNorm

↓

Residual CNN Block 1

↓

Residual CNN Block 2

↓

2-layer Bidirectional GRU

↓

Attention

↓

Shared Dense

├──────────────► Activity Head
└──────────────► Fall Risk Head

===============================================================
"""

import torch
import torch.nn as nn
import torch.nn.functional as F

# ============================================================
# Configuration
# ============================================================

WINDOW_SIZE = 100

NUM_FEATURES = 12

NUM_CLASSES = 8

CNN_CHANNELS = 64

GRU_HIDDEN = 64

GRU_LAYERS = 2

DROPOUT = 0.30


# ============================================================
# Residual CNN Block
# ============================================================

class ResidualBlock(nn.Module):

    def __init__(self, channels):

        super().__init__()

        self.conv1 = nn.Conv1d(
            channels,
            channels,
            kernel_size=3,
            padding=1
        )

        self.bn1 = nn.BatchNorm1d(channels)

        self.conv2 = nn.Conv1d(
            channels,
            channels,
            kernel_size=3,
            padding=1
        )

        self.bn2 = nn.BatchNorm1d(channels)

        self.relu = nn.ReLU()

    def forward(self, x):

        identity = x

        out = self.conv1(x)
        out = self.bn1(out)
        out = self.relu(out)

        out = self.conv2(out)
        out = self.bn2(out)

        out += identity

        out = self.relu(out)

        return out


# ============================================================
# Attention
# ============================================================

class Attention(nn.Module):

    def __init__(self, hidden_size):

        super().__init__()

        self.score = nn.Sequential(

            nn.Linear(hidden_size, hidden_size),

            nn.Tanh(),

            nn.Linear(hidden_size, 1)

        )

    def forward(self, x):

        weights = self.score(x)

        weights = torch.softmax(weights, dim=1)

        context = torch.sum(weights * x, dim=1)

        return context, weights


# ============================================================
# Main Network
# ============================================================

class FallNet(nn.Module):

    def __init__(self):

        super().__init__()

        # ----------------------------------------------
        # Input BatchNorm
        # ----------------------------------------------

        self.input_bn = nn.BatchNorm1d(NUM_FEATURES)

        # ----------------------------------------------
        # Initial CNN
        # ----------------------------------------------

        self.conv = nn.Conv1d(

            NUM_FEATURES,

            CNN_CHANNELS,

            kernel_size=3,

            padding=1

        )

        self.bn = nn.BatchNorm1d(CNN_CHANNELS)

        self.relu = nn.ReLU()

        # ----------------------------------------------
        # Residual CNN Blocks
        # ----------------------------------------------

        self.res1 = ResidualBlock(CNN_CHANNELS)

        self.res2 = ResidualBlock(CNN_CHANNELS)

        # ----------------------------------------------
        # Dropout
        # ----------------------------------------------

        self.dropout = nn.Dropout(DROPOUT)

        # ----------------------------------------------
        # Bidirectional GRU
        # ----------------------------------------------

        self.gru = nn.GRU(

            input_size=CNN_CHANNELS,

            hidden_size=GRU_HIDDEN,

            num_layers=GRU_LAYERS,

            batch_first=True,

            dropout=DROPOUT,

            bidirectional=True

        )

        # ----------------------------------------------
        # Layer Normalization
        # ----------------------------------------------

        self.layer_norm = nn.LayerNorm(

            GRU_HIDDEN * 2

        )

        # ----------------------------------------------
        # Attention
        # ----------------------------------------------

        self.attention = Attention(

            GRU_HIDDEN * 2

        )

        # ----------------------------------------------
        # Shared Dense Layer
        # ----------------------------------------------

        self.shared = nn.Sequential(

            nn.Linear(

                GRU_HIDDEN * 2,

                128

            ),

            nn.ReLU(),

            nn.Dropout(DROPOUT),

            nn.Linear(

                128,

                64

            ),

            nn.ReLU()

        )

        # ----------------------------------------------
        # Activity Head
        # ----------------------------------------------

        self.activity_head = nn.Linear(

            64,

            NUM_CLASSES

        )

        # ----------------------------------------------
        # Fall Risk Head
        # ----------------------------------------------

        self.risk_head = nn.Linear(

            64,

            1

        )
        # ============================================================
    # Forward Pass
    # ============================================================

    def forward(self, x):
        """
        Parameters
        ----------
        x : Tensor

        Shape:
            (batch_size, 100, 12)

        Returns
        -------
        activity_logits
            Shape:
            (batch_size, NUM_CLASSES)

        risk
            Shape:
            (batch_size, 1)

        attention_weights
            Shape:
            (batch_size, WINDOW_SIZE, 1)
        """

        # --------------------------------------------------------
        # BatchNorm expects:
        # (batch, channels, sequence)
        # --------------------------------------------------------

        x = x.permute(0, 2, 1)

        x = self.input_bn(x)

        # --------------------------------------------------------
        # Initial CNN
        # --------------------------------------------------------

        x = self.conv(x)
        x = self.bn(x)
        x = self.relu(x)

        # --------------------------------------------------------
        # Residual Block 1
        # --------------------------------------------------------

        x = self.res1(x)

        # --------------------------------------------------------
        # Residual Block 2
        # --------------------------------------------------------

        x = self.res2(x)

        # --------------------------------------------------------
        # Dropout
        # --------------------------------------------------------

        x = self.dropout(x)

        # --------------------------------------------------------
        # Convert for GRU
        # (batch, channels, sequence)
        # ->
        # (batch, sequence, channels)
        # --------------------------------------------------------

        x = x.permute(0, 2, 1)

        # --------------------------------------------------------
        # Bi-GRU
        # --------------------------------------------------------

        gru_output, hidden = self.gru(x)

        gru_output = self.layer_norm(gru_output)

        gru_output = self.dropout(gru_output)

        # --------------------------------------------------------
        # Attention
        # --------------------------------------------------------

        context, attention_weights = self.attention(gru_output)

        # --------------------------------------------------------
        # Shared Dense Features
        # --------------------------------------------------------

        features = self.shared(context)

        # --------------------------------------------------------
        # Activity Classification
        # --------------------------------------------------------

        activity_logits = self.activity_head(features)

        # --------------------------------------------------------
        # Fall Risk Prediction
        # --------------------------------------------------------

        risk = torch.sigmoid(
            self.risk_head(features)
        )

        return (
            activity_logits,
            risk,
            attention_weights
        )

    # ============================================================
    # Predict Probabilities
    # ============================================================

    @torch.no_grad()
    def predict(self, x):
        """
        Predict from a batch of windows.

        Input:
            (batch,100,12)

        Returns:

            predicted_class

            probabilities

            risk

            attention
        """

        self.eval()

        activity_logits, risk, attention = self.forward(x)

        probabilities = torch.softmax(
            activity_logits,
            dim=1
        )

        predicted_class = torch.argmax(
            probabilities,
            dim=1
        )

        return (
            predicted_class,
            probabilities,
            risk,
            attention
        )

    # ============================================================
    # Extract Deep Features
    # ============================================================

    @torch.no_grad()
    def extract_features(self, x):
        """
        Returns only the learned feature vector.

        Useful for visualization,
        clustering or anomaly detection.
        """

        self.eval()

        x = x.permute(0, 2, 1)

        x = self.input_bn(x)

        x = self.conv(x)
        x = self.bn(x)
        x = self.relu(x)

        x = self.res1(x)

        x = self.res2(x)

        x = x.permute(0, 2, 1)

        gru_output, _ = self.gru(x)

        gru_output = self.layer_norm(gru_output)

        context, _ = self.attention(gru_output)

        features = self.shared(context)

        return features
# ============================================================
# Weight Initialization
# ============================================================

def initialize_weights(model):
    """
    Initialize model weights.
    """

    for module in model.modules():

        # ----------------------------------------------
        # Conv1D
        # ----------------------------------------------
        if isinstance(module, nn.Conv1d):

            nn.init.kaiming_normal_(
                module.weight,
                mode="fan_out",
                nonlinearity="relu"
            )

            if module.bias is not None:
                nn.init.zeros_(module.bias)

        # ----------------------------------------------
        # Linear
        # ----------------------------------------------
        elif isinstance(module, nn.Linear):

            nn.init.xavier_uniform_(module.weight)

            if module.bias is not None:
                nn.init.zeros_(module.bias)

        # ----------------------------------------------
        # BatchNorm
        # ----------------------------------------------
        elif isinstance(module, nn.BatchNorm1d):

            nn.init.ones_(module.weight)

            nn.init.zeros_(module.bias)

        # ----------------------------------------------
        # LayerNorm
        # ----------------------------------------------
        elif isinstance(module, nn.LayerNorm):

            nn.init.ones_(module.weight)

            nn.init.zeros_(module.bias)

        # ----------------------------------------------
        # GRU
        # ----------------------------------------------
        elif isinstance(module, nn.GRU):

            for name, param in module.named_parameters():

                if "weight_ih" in name:
                    nn.init.xavier_uniform_(param.data)

                elif "weight_hh" in name:
                    nn.init.orthogonal_(param.data)

                elif "bias" in name:
                    nn.init.zeros_(param.data)


# ============================================================
# Save Model
# ============================================================

def save_model(model, filename="fallnet.pth"):

    torch.save(model.state_dict(), filename)

    print(f"\nModel saved successfully -> {filename}")


# ============================================================
# Load Model
# ============================================================

def load_model(filename="fallnet.pth",
               device="cpu"):

    model = FallNet()

    initialize_weights(model)

    model.load_state_dict(
        torch.load(
            filename,
            map_location=device
        )
    )

    model.to(device)

    model.eval()

    print(f"\nLoaded model -> {filename}")

    return model


# ============================================================
# Count Parameters
# ============================================================

def count_parameters(model):

    return sum(
        p.numel()
        for p in model.parameters()
        if p.requires_grad
    )


# ============================================================
# Print Model Information
# ============================================================

def model_summary(model):

    print()

    print("=" * 60)

    print("EARLY FALL DETECTION NETWORK")

    print("=" * 60)

    print(model)

    print()

    print("Trainable Parameters : {:,}".format(
        count_parameters(model)
    ))

    print("=" * 60)


